# ==========================================
# SMART MEDICAL-WASTE COLLECTION SYSTEM
# Environment Variables Configuration
# ==========================================

# Backend Database URL (SQLite default for academic project, PostgreSQL compatible)
DATABASE_URL=sqlite:///./medical_waste.db

# JWT Secret Key for authenticating hospital, collector and admin tokens
JWT_SECRET=super-secret-smart-medical-waste-jwt-key-change-in-prod-2026

# Allowed CORS Origins (comma-separated)
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173,http://localhost:3000

# Google Maps JavaScript API Key (Optional: Map automatically falls back to OpenStreetMap/Leaflet engine if not provided)
VITE_GOOGLE_MAPS_API_KEY=
